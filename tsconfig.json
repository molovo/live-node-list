{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["dom", "dom.iterable", "ES2021"],
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUnusedLocals": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "incremental": true,
    "outDir": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "!src/**/*"]
}
